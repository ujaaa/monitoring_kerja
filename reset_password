<?php

require_once "koneksi.php";

$username_target = "user";           // username yang mau direset
$password_baru   = "1234";    // password baru yang akan dipakai login

$hash_baru = password_hash($password_baru, PASSWORD_DEFAULT);

$stmt = $conn->prepare("UPDATE users SET password = ? WHERE username = ?");
$stmt->bind_param("ss", $hash_baru, $username_target);

if ($stmt->execute()) {
    echo "Password untuk '$username_target' berhasil direset ke: $password_baru";
} else {
    echo "Gagal reset password.";
}

?>